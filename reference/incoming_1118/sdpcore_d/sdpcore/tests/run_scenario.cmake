# Прогон сценария sdp_run и проверка критериев, записанных в самом сценарии строками «#! ...»:
#   #! есть: <текст>            — в выводе должна быть строка с этим текстом
#   #! нет: <текст>             — такого текста в выводе быть не должно
#   #! итог_положение < <м>     — наибольшая ошибка положения из строки ИТОГ меньше порога
#   #! итог_курс < <°>          — наибольшая ошибка курса из строки ИТОГ меньше порога
#   #! не больше <N>: <текст>   — текст встречается в выводе не больше N раз (например, тревога не мигает)
# Запуск: cmake -DSDP_RUN=<sdp_run> -DSCEN=<сценарий.txt> -P run_scenario.cmake
execute_process(COMMAND ${SDP_RUN} --script ${SCEN} --status 30 OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
set(out "${out}${err}")
message("${out}")
set(bad 0)
if(NOT rc EQUAL 0)
  message("FAIL sdp_run завершился с кодом ${rc}")
  math(EXPR bad "${bad}+1")
endif()
file(STRINGS ${SCEN} crit ENCODING UTF-8 REGEX "^#! ")
if(NOT crit)
  message(FATAL_ERROR "в сценарии нет ни одного критерия «#! ...»")
endif()
string(REGEX MATCH "наибольшая ([0-9.]+) м; курса [0-9.]+°, наибольшая ([0-9.]+)°" itog "${out}")
set(maxPos "${CMAKE_MATCH_1}")
set(maxHdg "${CMAKE_MATCH_2}")
foreach(c IN LISTS crit)
  string(REGEX REPLACE "^#! *" "" c "${c}")
  if(c MATCHES "^есть: *(.+)$")
    string(FIND "${out}" "${CMAKE_MATCH_1}" pos)
    if(pos EQUAL -1)
      message("FAIL нет в выводе: ${CMAKE_MATCH_1}")
      math(EXPR bad "${bad}+1")
    else()
      message("  ok есть: ${CMAKE_MATCH_1}")
    endif()
  elseif(c MATCHES "^нет: *(.+)$")
    string(FIND "${out}" "${CMAKE_MATCH_1}" pos)
    if(NOT pos EQUAL -1)
      message("FAIL в выводе есть лишнее: ${CMAKE_MATCH_1}")
      math(EXPR bad "${bad}+1")
    else()
      message("  ok нет: ${CMAKE_MATCH_1}")
    endif()
  elseif(c MATCHES "^не больше ([0-9]+): *(.+)$")
    set(lim "${CMAKE_MATCH_1}")
    set(txt "${CMAKE_MATCH_2}")
    string(ASCII 1 mark)   # «\x01» в строке CMake на части версий — ошибка разбора (CMake на Mac)
    string(REPLACE "${txt}" "${mark}" tmp "${out}")
    string(REGEX MATCHALL "${mark}" hits "${tmp}")
    list(LENGTH hits cnt)
    if(cnt GREATER lim)
      message("FAIL «${txt}» встречается ${cnt} раз, допустимо не больше ${lim}")
      math(EXPR bad "${bad}+1")
    else()
      message("  ok «${txt}»: ${cnt} раз (не больше ${lim})")
    endif()
  elseif(c MATCHES "^итог_(положение|курс) *< *([0-9.]+)$")
    set(what "${CMAKE_MATCH_1}")
    set(lim "${CMAKE_MATCH_2}")
    if(what STREQUAL "положение")
      set(v "${maxPos}")
    else()
      set(v "${maxHdg}")
    endif()
    if(v STREQUAL "")
      message("FAIL нет строки ИТОГ")
      math(EXPR bad "${bad}+1")
    elseif(v LESS lim)
      message("  ok итог ${what}: ${v} < ${lim}")
    else()
      message("FAIL итог ${what}: ${v}, допустимо меньше ${lim}")
      math(EXPR bad "${bad}+1")
    endif()
  else()
    message(FATAL_ERROR "непонятный критерий: ${c}")
  endif()
endforeach()
if(bad GREATER 0)
  message(FATAL_ERROR "сценарий ${SCEN}: не выполнено критериев — ${bad}")
endif()
